{
  "name": "@codepol/plugin-vulture",
  "version": "1.0.0",
  "description": "Vulture dead-code adapter for codepol – detects unused Python code via subprocess",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@codepol/core": "^1.0.0"
  },
  "devDependencies": {
    "@codepol/core": "workspace:*",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fruitiecutiepie/codepol",
    "directory": "packages/plugin-vulture"
  },
  "license": "MIT",
  "keywords": [
    "codepol",
    "vulture",
    "python",
    "dead-code",
    "adapter"
  ]
}
