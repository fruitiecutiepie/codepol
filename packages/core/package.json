{
  "name": "@codepol/core",
  "version": "1.0.0",
  "description": "Core policy loading, Tree-sitter scanning, and enforcement for codepol",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "fast-glob": "^3.3.3",
    "minimatch": "^10.1.1",
    "web-tree-sitter": "^0.24.7"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fruitiecutiepie/codepol",
    "directory": "packages/core"
  },
  "license": "MIT",
  "keywords": [
    "policy",
    "web-tree-sitter",
    "typescript",
    "logging",
    "enforcement"
  ]
}
