{
  "name": "@codepol/eslint-plugin",
  "version": "1.0.0",
  "description": "ESLint plugin for enforcing logger instrumentation with autofix support",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "minimatch": "^10.1.1"
  },
  "peerDependencies": {
    "@codepol/core": "^1.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@codepol/core": "workspace:*",
    "@types/node": "^25.0.3",
    "@typescript-eslint/utils": "^8.51.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fruitiecutiepie/codepol",
    "directory": "packages/eslint-plugin"
  },
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "logging",
    "typescript",
    "autofix"
  ]
}
