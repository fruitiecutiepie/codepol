{
  "name": "@codepol/workspace-service",
  "version": "1.0.0",
  "description": "Shared workspace analysis service for codepol adapters",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js",
      "require": "./dist/daemon.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codepol/core": "workspace:*",
    "@codepol/plugin": "workspace:*",
    "@codepol/plugin-biome": "workspace:*",
    "@codepol/plugin-eslint": "workspace:*",
    "@codepol/plugin-ruff": "workspace:*",
    "@codepol/plugin-vulture": "workspace:*",
    "chokidar": "^5.0.0",
    "eslint": "^9.39.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fruitiecutiepie/codepol",
    "directory": "packages/workspace-service"
  },
  "license": "MIT"
}
