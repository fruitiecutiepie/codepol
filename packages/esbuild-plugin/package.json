{
  "name": "@codepol/esbuild-plugin",
  "version": "1.0.0",
  "description": "esbuild plugin for enforcing codepol policies during builds",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@codepol/core": "^1.0.0",
    "@codepol/plugin": "^1.0.0",
    "@codepol/eslint-plugin": "^1.0.0",
    "esbuild": ">=0.17.0",
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@codepol/core": "workspace:*",
    "@codepol/eslint-plugin": "workspace:*",
    "@codepol/plugin": "workspace:*",
    "@types/node": "^25.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fruitiecutiepie/codepol",
    "directory": "packages/esbuild-plugin"
  },
  "license": "MIT",
  "keywords": [
    "esbuild",
    "esbuild-plugin",
    "policy",
    "logging",
    "typescript",
    "build"
  ]
}
