{
  "name": "extension-vscode",
  "displayName": "Codepol",
  "version": "1.0.0",
  "description": "VS Code client for the Codepol LSP",
  "private": true,
  "publisher": "codepol",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:codepol.toml",
    "onCommand:codepol.extension.showArchitectureSummary",
    "onCommand:codepol.extension.showDependencyGraph",
    "onCommand:codepol.extension.showSemanticDefinition",
    "onCommand:codepol.extension.showSemanticSearch",
    "onCommand:codepol.extension.showArchitectureLinks",
    "onCommand:codepol.architecture.peek",
    "onCommand:codepol.extension.showLintRuleDetails",
    "onCommand:codepol.extension.showLintRuleDiagnosticFixes",
    "onCommand:codepol.extension.renameCodepolEntity",
    "onCommand:codepol.extension.refreshLintRules",
    "onCommand:codepol.extension.refreshRenameTargets",
    "onView:codepol.currentContext",
    "onView:codepol.lintRules",
    "onView:codepol.renameTargets"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codepol.extension.showArchitectureSummary",
        "title": "Codepol: Show Architecture Summary",
        "enablement": "codepol.indexBackedCommandsEnabled"
      },
      {
        "command": "codepol.extension.showDependencyGraph",
        "title": "Codepol: Show Dependency Graph",
        "enablement": "codepol.indexBackedCommandsEnabled"
      },
      {
        "command": "codepol.extension.showSemanticDefinition",
        "title": "Codepol: Show Semantic Definition"
      },
      {
        "command": "codepol.extension.showSemanticSearch",
        "title": "Codepol: Semantic Search",
        "enablement": "codepol.indexBackedCommandsEnabled"
      },
      {
        "command": "codepol.extension.showArchitectureLinks",
        "title": "Codepol: Show Architecture Links",
        "enablement": "codepol.indexBackedCommandsEnabled"
      },
      {
        "command": "codepol.architecture.peek",
        "title": "Codepol: Peek Architecture",
        "enablement": "codepol.indexBackedCommandsEnabled"
      },
      {
        "command": "codepol.extension.renameCodepolEntity",
        "title": "Codepol: Rename Codepol Entity"
      },
      {
        "command": "codepol.extension.showLintRuleDetails",
        "title": "Codepol: Open Lint Rule Details Panel"
      },
      {
        "command": "codepol.extension.showLintRuleDiagnosticFixes",
        "title": "Codepol: Quick Fix..."
      },
      {
        "command": "codepol.extension.refreshLintRules",
        "title": "Codepol: Refresh Lint Rules"
      },
      {
        "command": "codepol.extension.refreshRenameTargets",
        "title": "Codepol: Refresh Rename Targets"
      },
      {
        "command": "codepol.extension.setDiagnosticsEnvironment",
        "title": "Codepol: Set Diagnostics Environment"
      },
      {
        "command": "codepol.extension.addDiagnosticsEscalation",
        "title": "Codepol: Add Diagnostics Escalation"
      },
      {
        "command": "codepol.extension.clearDiagnosticsEscalations",
        "title": "Codepol: Clear Diagnostics Escalations"
      },
      {
        "command": "codepol.extension.showDiagnosticsConfig",
        "title": "Codepol: Show Current Diagnostics Config"
      },
      {
        "command": "codepol.extension.restartDaemon",
        "title": "Codepol: Restart Daemon"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepol",
          "title": "Codepol",
          "icon": "media/codepol.svg"
        }
      ]
    },
    "views": {
      "codepol": [
        {
          "id": "codepol.currentContext",
          "name": "Search & Details",
          "type": "webview"
        },
        {
          "id": "codepol.lintRules",
          "name": "Lint Rules"
        },
        {
          "id": "codepol.renameTargets",
          "name": "Rename Targets"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codepol.extension.refreshRenameTargets",
          "when": "view == codepol.currentContext",
          "group": "navigation"
        },
        {
          "command": "codepol.extension.refreshLintRules",
          "when": "view == codepol.lintRules",
          "group": "navigation"
        },
        {
          "command": "codepol.extension.refreshRenameTargets",
          "when": "view == codepol.renameTargets",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codepol.extension.showLintRuleDetails",
          "when": "view == codepol.lintRules && viewItem == codepol.lintRule",
          "group": "inline"
        },
        {
          "command": "codepol.extension.showLintRuleDiagnosticFixes",
          "when": "view == codepol.lintRules && viewItem == codepol.lintRuleDiagnostic.fixable",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Codepol",
      "properties": {
        "codepol.lsp.verboseDiagnostics": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable verbose Codepol LSP diagnostics in the `Codepol LSP` output channel. Superseded stale requests are logged at trace level only when this setting is enabled."
        },
        "codepol.diagnostics.environment": {
          "type": "string",
          "enum": ["user", "dev", "test", "verbose"],
          "default": "user",
          "markdownDescription": "Named diagnostics preset. `user` is the safe field posture; `dev` is productive daily; `test` is deterministic verification; `verbose` is temporary investigation. Overlays in `codepol.diagnostics.overrides` layer on top, and escalations in `codepol.diagnostics.escalations` apply with a TTL."
        },
        "codepol.diagnostics.overrides": {
          "type": "object",
          "default": {},
          "markdownDescription": "Partial `RuntimeDiagnosticsPolicy` overlaid on the selected environment. Examples: `{ \"level\": \"debug\" }`, `{ \"sinks\": [\"console\",\"file\"], \"logFilePath\": \"/tmp/codepol.log\" }`, `{ \"scopes\": { \"parser\": \"trace\" } }`.",
          "properties": {
            "level": { "type": "string", "enum": ["error", "warn", "info", "debug", "trace"] },
            "scopes": {
              "type": "object",
              "additionalProperties": { "type": "string", "enum": ["error", "warn", "info", "debug", "trace"] }
            },
            "sinks": {
              "type": "array",
              "items": { "type": "string", "enum": ["console", "file", "memory", "stdout", "otel"] }
            },
            "logFilePath": { "type": "string" },
            "otelEndpoint": { "type": "string" },
            "tracing": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "metrics": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "snapshots": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "maxBytes": { "type": "number", "minimum": 0 }
              }
            },
            "checks": {
              "type": "object",
              "properties": {
                "invariants": { "type": "string", "enum": ["off", "cheap", "full"] }
              }
            },
            "redaction": {
              "type": "object",
              "properties": {
                "mode": { "type": "string", "enum": ["strict", "standard", "off"] }
              }
            }
          }
        },
        "codepol.diagnostics.escalations": {
          "type": "array",
          "default": [],
          "markdownDescription": "Standing diagnostics escalations applied on activation. Each entry is `{ scope, level, ttlSec, reason }`. Scope can be `global`, `scope:<dotted>`, `request:<id>`, or `workspace:<id>`.",
          "items": {
            "type": "object",
            "required": ["scope", "level", "ttlSec"],
            "properties": {
              "scope": { "type": "string" },
              "level": { "type": "string", "enum": ["error", "warn", "info", "debug", "trace"] },
              "ttlSec": { "type": "number", "minimum": 1 },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "files": [
    "dist",
    "media"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "bundle": "node ./scripts/build-bundle.mjs",
    "bundle:prod": "node ./scripts/build-bundle.mjs --production",
    "watch": "tsc -b tsconfig.json --watch --preserveWatchOutput",
    "package:vsix": "pnpm --dir .. run build:extension-vscode-vsix-stack && node ./scripts/package-vsix.mjs",
    "typecheck": "pnpm --filter @codepol/core build && pnpm --filter @codepol/lsp build && tsc --noEmit",
    "test:smoke": "pnpm run build && node ./dist/smoke/run.js"
  },
  "dependencies": {
    "@codepol/core": "workspace:*",
    "@codepol/lsp": "workspace:*",
    "@codepol/workspace-service": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.2",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fruitiecutiepie/codepol",
    "directory": "extension-vscode"
  },
  "license": "MIT"
}
