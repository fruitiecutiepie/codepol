{
  "compilerOptions": {
    "target": "ES2019",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["tools/**/*.ts", "tests/**/*.ts", "policy.json"],
  "exclude": ["dist", "node_modules"]
}
