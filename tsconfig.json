{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@codepol/core": ["./packages/core/src/index.ts"],
      "@codepol/lsp": ["./apps/lsp/src/index.ts"],
      "@codepol/lsp/protocol": ["./apps/lsp/src/protocol.ts"],
      "@codepol/plugin-biome": ["./packages/plugin-biome/src/index.ts"],
      "@codepol/plugin-eslint": ["./packages/plugin-eslint/src/index.ts"],
      "@codepol/plugin-esbuild": ["./packages/plugin-esbuild/src/index.ts"],
      "@codepol/plugin": ["./packages/plugin/src/index.ts"],
      "@codepol/type-aware-provider": ["./packages/type-aware-provider/src/index.ts"],
      "@codepol/workspace-service": ["./packages/workspace-service/src/index.ts"],
      "@codepol/workspace-service/daemon": ["./packages/workspace-service/src/daemon.ts"],
      "@codepol/workspace-service/contracts": ["./packages/workspace-service/src/contracts.ts"]
    }
  },
  "include": ["tests/**/*.ts"],
  "exclude": ["dist", "node_modules", "packages", "apps"],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/plugin-biome" },
    { "path": "./packages/plugin-eslint" },
    { "path": "./packages/plugin-esbuild" },
    { "path": "./packages/plugin" },
    { "path": "./packages/type-aware-provider" },
    { "path": "./packages/workspace-service" },
    { "path": "./apps/cli" },
    { "path": "./apps/lsp" },
    { "path": "./extension-vscode" }
  ]
}
