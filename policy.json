{
  "$schema": "./policy.schema.json",
  "plugins": [
    {
      "builtin": "logger"
    }
  ],
  "rules": [
    {
      "id": "function-logging",
      "semantics": {
        "description": "Ensure all exported TypeScript functions are wrapped with logger enter/exit",
        "type": "logger"
      },
      "targets": [
        {
          "language": "typescript",
          "files": ["src/**/*.ts", "src/**/*.tsx"],
          "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/__mocks__/**"]
        }
      ]
    }
  ],
  "exclude": ["dist/**"],
  "logger": {
    "identifier": "logger",
    "enterMethod": "enter",
    "exitMethod": "exit",
    "import": {
      "module": "@org/logger",
      "named": "logger"
    }
  }
}
