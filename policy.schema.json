{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Logging Policy",
  "type": "object",
  "required": ["targets", "rules"],
  "definitions": {
    "target": {
      "type": "object",
      "required": ["language", "files"],
      "properties": {
        "language": { "type": "string" },
        "parser": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["module"],
            "properties": {
              "module": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "targets": {
      "type": "object",
      "description": "Named target definitions that rules reference by name",
      "additionalProperties": { "$ref": "#/definitions/target" },
      "minProperties": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "targets"],
        "properties": {
          "id": { "type": "string" },
          "ruleId": { "type": "string" },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["error", "warn", "off"],
            "default": "error",
            "description": "Lint severity level"
          },
          "providers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Providers to apply this rule to (default: all providers). e.g., ['eslint', 'tree-sitter']"
          },
          "args": {},
          "targets": {
            "type": "array",
            "description": "Array of target names referencing entries in top-level targets",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
