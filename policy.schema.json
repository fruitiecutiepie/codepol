{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Logging Policy",
  "type": "object",
  "required": ["rules", "logger"],
  "properties": {
    "$schema": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "builtin": { "type": "string" },
          "module": { "type": "string" },
          "export": { "type": "string" }
        },
        "additionalProperties": false,
        "oneOf": [
          { "required": ["builtin"] },
          { "required": ["module"] }
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "language", "files"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "type": { "type": "string", "default": "logger" },
          "language": {
            "type": "string",
            "enum": ["typescript", "tsx"]
          },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "exclude": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" }
    },
    "logger": {
      "type": "object",
      "required": ["identifier", "enterMethod", "exitMethod", "import"],
      "properties": {
        "identifier": { "type": "string" },
        "enterMethod": { "type": "string" },
        "exitMethod": { "type": "string" },
        "import": {
          "type": "object",
          "required": ["module", "named"],
          "properties": {
            "module": { "type": "string" },
            "named": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
