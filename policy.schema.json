{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Policy",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "$schema": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "pluginConfig": {
      "type": "object",
      "additionalProperties": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "language", "files", "type", "config"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "language": {
            "type": "string",
            "enum": ["typescript", "tsx"]
          },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "exclude": {
            "type": "array",
            "items": { "type": "string" }
          },
          "type": { "type": "string" },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
