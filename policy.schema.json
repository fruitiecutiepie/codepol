{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Logging Policy",
  "type": "object",
  "required": ["rules"],
  "definitions": {},
  "properties": {
    "$schema": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "builtin": { "type": "string" },
          "module": { "type": "string" },
          "export": { "type": "string" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "enabled": { "type": "boolean", "default": true },
                "args": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "oneOf": [
          { "required": ["builtin"] },
          { "required": ["module"] }
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "semantics", "targets"],
        "properties": {
          "id": { "type": "string" },
          "semantics": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "description": { "type": "string" },
              "type": { "type": "string", "default": "logger" }
            },
            "additionalProperties": false
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["language", "files"],
              "properties": {
                "language": { "type": "string" },
                "parser": { "type": "string" },
                "files": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "exclude": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
