{
  "name": "codepol",
  "version": "1.0.0",
  "description": "Policy-driven code enforcement for TypeScript projects",
  "type": "commonjs",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist",
    "typecheck": "pnpm -r typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "@typescript-eslint/utils": "8.51.0",
    "ajv": "8.17.1",
    "chokidar": "5.0.0",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "fast-glob": "3.3.3",
    "minimatch": "10.1.1",
    "tree-sitter": "0.21.1",
    "tree-sitter-typescript": "0.23.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "4.0.16",
    "yargs": "18.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fruitiecutiepie/codepol"
  },
  "license": "MIT",
  "keywords": [
    "eslint",
    "esbuild",
    "policy",
    "logging",
    "typescript",
    "tree-sitter"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "tree-sitter",
      "tree-sitter-javascript",
      "tree-sitter-typescript"
    ]
  }
}
