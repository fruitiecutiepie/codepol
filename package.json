{
  "name": "codepol",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "policy:check": "ts-node --project tsconfig.json tools/policy-check.ts",
    "policy:fix": "ts-node --project tsconfig.json tools/policy-check.ts --fix",
    "policy:watch": "ts-node --project tsconfig.json tools/policy-check.ts --watch"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "@typescript-eslint/utils": "8.51.0",
    "ajv": "8.17.1",
    "chokidar": "5.0.0",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "fast-glob": "3.3.3",
    "minimatch": "10.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.0.16",
    "yargs": "18.0.0"
  }
}
