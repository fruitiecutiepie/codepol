{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "codepol: build extension-vscode stack",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "build:extension-vscode-stack"],
      "problemMatcher": []
    },
    {
      "label": "codepol: watch extension-vscode stack",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev:extension-vscode-stack"],
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "codepol: smoke extension-vscode",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "test:extension-vscode:smoke"],
      "problemMatcher": []
    }
  ]
}
