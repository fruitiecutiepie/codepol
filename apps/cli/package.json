{
  "name": "@codepol/cli",
  "version": "1.0.0",
  "description": "Command-line interface for running codepol policy checks",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codepol": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "@codepol/daemon": "workspace:*",
    "@codepol/core": "workspace:*",
    "@codepol/plugin": "workspace:*",
    "@codepol/plugin-biome": "workspace:*",
    "@codepol/workspace-service": "workspace:*",
    "chokidar": "^5.0.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/yargs": "^17.0.35",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fruitiecutiepie/codepol",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "codepol",
    "policy",
    "linting",
    "typescript"
  ]
}
